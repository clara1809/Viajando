# Completá los valores con la configuración de tu aplicación web en Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Servicios OSM: sin clave turística. Variables solo del servidor.
OSM_APP_CONTACT=
# Opcionales: permiten cambiar de proveedor sin cambiar código.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Opcional: endpoint SPARQL de Wikidata, sin clave.
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
